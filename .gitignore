__pycache__/
*.pyc
*.db
*.db-journal
*.db-wal
*.db-shm
proyectos.json
proyectos_ec.json
.venv/
venv/
.env
.claude/
update.log

# Snapshot del estado bajo data/ (Excel y DB comprimida) sí se commitean,
# se restauran con `python -m scraper.cli restaurar`.
!data/
!data/ProyectosDeLey.xlsx
!data/proyectos.db.gz

# Estado del scheduler de alertas (commiteado por GH Actions)
!data/alert_sent_log.json

# Lista de usuarios registrados (escrito por la app via GitHub API)
!data/users.json
!data/proyectos_ec.db.gz
scripts/recon_agenda_output.json

# Proyecto aparte (mapas electorales geopandas), creado aquí por error
mapa_electoral/

# Notas y bluebooks de clientes: info de negocio confidencial, este repo es
# publico. Se versiona SOLO notas.md/historial_alertas.md/formato_alertas.md
# de cada cliente (lo que alerts/relevancia.py y el filtro Cliente necesitan
# leer de verdad) - decision explicita de Nicolas, 2026-09-13. Todo lo demas
# (bluebooks originales que dieron los propios clientes, clientes/chat.txt
# con el chat interno del equipo, clientes/_plantillas/) sigue local-only,
# nada de eso lo lee el codigo en runtime.
clientes/*
!clientes/*/
clientes/*/*
!clientes/*/notas.md
!clientes/*/historial_alertas.md
!clientes/*/formato_alertas.md
