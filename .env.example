# Copiar a .env y completar para correr localmente.

# Email (Resend) — usado por alerts/ y auth/ (magic links)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM=Vali Intelligence <onboarding@resend.dev>

# (legacy fallback si data/users.json esta vacio)
ALERT_RECIPIENT=nicolas.silva@valiconsultores.com

# Auth — secret para firmar magic link tokens (cualquier string largo random)
JWT_SECRET=cambiame-por-algo-random-32-chars-min-aaaaaa

# URL base de la app (para construir magic links)
# En dev: http://localhost:8501
# En Streamlit Cloud: https://<tu-app>.streamlit.app
APP_BASE_URL=http://localhost:8501

# GitHub Contents API — para persistir registros nuevos en users.json
# Crear Personal Access Token en https://github.com/settings/tokens?type=beta
# Permisos: Contents: Read and write sobre nicosil02/Base_legislativa
GH_TOKEN=ghp_xxxxxxxxxxxxxxxxxx
GH_REPO=nicosil02/Base_legislativa
GH_BRANCH=main
