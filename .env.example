# Copiar a .env y completar para correr la app en la PC.
# El .env nunca se sube (esta en .gitignore). La lista completa de secretos
# y para que sirve cada uno esta en docs/INSTALAR.md.

# Abre la app sin el login de Google. Solo para la PC.
VALI_SIN_LOGIN=1

# Clave de los datos de clientes cifrados (clientes/privado.py).
# Sin ella la app arranca igual, pero sin las fichas de clientes.
CLIENTES_CLAVE=

# Gemini: chat sobre transcripciones y preguntas al grafo.
GEMINI_API_KEY=

# GitHub: guarda en el repo lo que marca el analista (core/store.py).
# Token con permiso Contents de lectura y escritura sobre este repo.
# Sin el, la app guarda en archivos locales.
GH_TOKEN=
GH_REPO=nicosil02/Base_legislativa
GH_BRANCH=main

# Avisos por Telegram (solo para probar envios desde la PC).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Correo diario por Resend (solo para probar envios desde la PC).
RESEND_API_KEY=
RESEND_FROM=
ALERT_RECIPIENT=
